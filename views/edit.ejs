<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
</head>

<body>

    <h1>Edit Student</h1>

    <form action="/student/edit/<%= Student._id %>" method="post">

        <label>Name</label>
        <input
            type="text"
            name="name"
            value="<%= Student.name %>"
            required
        >

        <br><br>

        <label>Email</label>
        <input
            type="email"
            name="email"
            value="<%= Student.email %>"
            required
        >

        <br><br>

        <label>Phone</label>
        <input
            type="text"
            name="phone"
            value="<%= Student.phone %>"
            required
        >

        <br><br>

        <label>Image</label>
        <input
            type="text"
            name="image"
            value="<%= Student.image %>"
        >

        <br><br>

        <label>Status</label>
        <input
            type="text"
            name="status"
            value="<%= Student.status %>"
        >

        <br><br>

        <button type="submit">Update</button>

    </form>

</body>

</html>